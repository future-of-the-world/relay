{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["-I", "${CLAUDE_PLUGIN_ROOT}/hooks/refuse-agent.py"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
