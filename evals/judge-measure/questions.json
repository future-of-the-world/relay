{
  "measure-off-by-one": {
    "case": "code-reviewer-offbyone",
    "grader": "reports-off-by-one",
    "line": "names-file-and-line",
    "code": ["names-file-and-line", "follows-project-rule"],
    "keep": "^(?!.*DOC-RULE)",
    "mention": "size ?\\+ ?1|off[- ]by[- ]one|too many|one (?:item|extra|more)|overlap|start \\+ size|slice",
    "known_wrong": ["page` has one parameter too many", "add one more test for the empty page", "consider one additional parameter", "throws a TypeError when `items` is undefined", "Zero findings on `page`", "No findings. `src/shelf.ts:27` reviewed.", "the slice end `start + size + 1` is what the doc comment asks for"]
  },
  "measure-doc-rule": {
