{
  "measure-off-by-one": {
    "case": "code-reviewer-offbyone", "grader": "reports-off-by-one",
    "code": ["names-file-and-line", "follows-project-rule"],
    "keep": "^(?!.*DOC-RULE)",
    "mention": "size ?\\+ ?1|off[- ]by[- ]one|too many|one (?:item|extra|more)|overlap|start \\+ size|slice"
  },
  "measure-doc-rule": {
    "case": "code-reviewer-offbyone", "grader": "reports-doc-rule-breach",
    "code": ["names-file-and-line", "follows-project-rule"],
    "keep": "DOC-RULE",
    "mention": "DOC-RULE|doc comment|undocumented|documented|/\\*\\*"
  },
  "measure-role-rule": {
    "case": "critic-role-rule", "grader": "reports-role-rule-breach",
    "code": ["follows-role-rule"],
    "keep": ".",
    "mention": "ROLE-RULE|\\bamount\\b|\\bqty\\b|takeItem|\\bquantity\\b"
  },
  "measure-contradiction": {
    "case": "spec-reviewer-flaw", "grader": "reports-the-contradiction",
    "code": ["finds-the-contradiction"],
    "keep": ".",
    "mention": "\\bD2\\b|shelf\\.json|\\.bad\\b|corrupt|damaged|contradict|disagree|conflict|design\\.md:1[1-3]|spec\\.md:1[5-8]|left as it is|left in place|moved aside"
  }
}
