  "measure-contradiction": {
    "case": "spec-reviewer-flaw",
    "grader": "reports-the-contradiction",
    "line": "finds-the-contradiction",
    "code": ["finds-the-contradiction"],
    "keep": ".",
    "mention": "\\bD2\\b|shelf\\.json|\\.bad\\b|corrupt|damaged|contradict|disagree|conflict|design\\.md:1[1-3]|spec\\.md:1[5-8]|left as it is|left in place|moved aside"
  }
