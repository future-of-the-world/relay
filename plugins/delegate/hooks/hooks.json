{
  "description": "Routing guard: typed agents only, no forks from big sessions, Opus only for thinker/critic unless escalated.",
  "hooks": {
    "PreToolUse": [
      { "matcher": "Agent|Task", "hooks": [{ "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/route-guard.py"], "timeout": 10 }] },
      { "hooks": [{ "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/turn-limit.py"], "timeout": 10 }] },
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/read-only-guard.py"], "timeout": 10 }] }
    ]
  }
}
