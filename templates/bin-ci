#!/usr/bin/env bash
# bin/ci: the full gate (the relay contract: quiet, log in .ci/ci.log, exit 0 only when green).
set -uo pipefail
root="$(git rev-parse --show-toplevel)"; cd "$root"
mkdir -p .ci; : > .ci/ci.log
status=0
step() { local name="$1"; shift; local start=$(date +%s) from own last
  from=$(wc -c < .ci/ci.log)  # the step appends to the log live (a killed gate keeps what a hung step wrote); its own part starts here
  if "$@" >> .ci/ci.log 2>&1; then echo "ci: $name ok ($(( $(date +%s) - start ))s)"
  else echo "ci: $name FAILED ($(( $(date +%s) - start ))s, log: .ci/ci.log)"
    own="$(tail -c +$((from + 1)) .ci/ci.log)"
    # the lines that look like a failure, then the step's last line whatever its wording (e.g. "No module named pytest")
    grep -nE 'FAIL|error|Error' <<<"$own" | tail -8 | sed 's/^/    /'
    last="$(grep -v '^[[:space:]]*$' <<<"$own" | tail -1)"
    [ -n "$last" ] && ! grep -qxF -- "$last" <(grep -E 'FAIL|error|Error' <<<"$own") && echo "    $last"
    status=1; fi; }
# TODO ({{stack}}, {{tool}}): the steps. Examples:
#   step "format" bun run format --check
#   step "types"  bun run typecheck
#   step "lint"   bun run lint
#   step "tests"  bun test
#   step "build"  bun run build
{{ci_steps}}
[ "$status" -eq 0 ] && echo "ci: green" || echo "ci: RED"
exit $status
