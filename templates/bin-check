#   run_step("format", ["bun", "run", "format", "--check"])
#   run_step("types", ["bun", "run", "typecheck"])
#   run_step("tests", ["bun", "test", *TEST_FILES])
{{check_steps}}
try:
    os.remove(FAILS)
except FileNotFoundError:
    pass
print(f"passed ({ELAPSED} min since the first check of this task)")
if ELAPSED >= MINUTES:
    print("TIME BUDGET SPENT")
sys.exit(0)
