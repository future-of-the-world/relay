#!/usr/bin/env python3
"""Money limits and estimates of paid runs (`claude plugin eval`), from the costs relay measured itself.

  bin/paid-cost ceiling --cap USD --jobs N [--dir DIR]   prints "<jobs> <ceiling>": what to pass as -j and --max-cost-usd
  bin/paid-cost ceiling ... --within-day                 the same, with --cap lowered to what is left of the day's cap
  bin/paid-cost estimate [--dir DIR]                     prints the mean and max cost of a stored batch, or "not measured yet"
  bin/paid-cost due [--dir DIR] [--repo REPO]            prints the merged changes no green paid run covers yet; nothing when none
  bin/paid-cost today                                    prints the day's spend, the owner's daily cap and the run count (UTC day)
  bin/paid-cost cap [USD]                                prints the daily cap from projects.toml [global]; with USD it lands the change as one commit on the default branch
  bin/paid-cost guard eval                               exits 1 with a refusal line when the next plugin eval batch (the largest stored one) would pass the day's cap

DIR holds the eval records bin/eval-record stores ($RELAY_HOME/evals/<repo>/*.json, RELAY_HOME defaults to ~/.relay).
The eval tool enforces the ceiling itself but lets the runs in flight finish, so a batch can end up to one run per
job above the ceiling. Passing the owner's cap minus (jobs - 1) x the largest cost of one run measured so far keeps
the batch within one run of the cap. When that leaves less than one run, or no run was measured, it is -j 1 and the
cap itself. Only full batches count in the estimate; the finished runs of a partial batch still count for the ceiling.
"""
import argparse, datetime, json, os, subprocess, sys
from importlib.machinery import SourceFileLoader
import importlib.util

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(HERE, "..", "lib"))
import relay_git  # noqa: E402
import relay_paidcap  # noqa: E402

# What the paid evals read: a change to one of these is checked by the next paid run (hooks and eval cases included).
CHECKED_PATHS = [":(glob)roles/**", ":(glob)rules/**", ":(glob)plugins/*/skills/**", ":(glob)plugins/*/agents/**",
                 ":(glob)plugins/*/hooks/**", ":(glob)evals/plugin/**"]
SHOW_LIMIT = 50  # with no green run recorded, only this many of the newest commits are listed

MIN_RUNS = 2  # fewer measured batches than this give no estimate


def _num(v):
    return isinstance(v, (int, float)) and not isinstance(v, bool) and v >= 0


def stored(folder):
    """[(batch cost, partial, [cost of each run])] of the stored records that have a batch cost and runs; unreadable files are skipped.
    A run costs its costUsd + judgeCostUsd; a run with no numeric costUsd is left out."""
    out = []
    try:
        names = sorted(os.listdir(folder))
    except OSError:
        return out
    for name in names:
        if not name.endswith(".json"):
            continue
        try:
            d = json.load(open(os.path.join(folder, name), encoding="utf-8"))
            runs = [r for c in d["cases"] for rs in c["arms"].values() for r in rs]
            cost = d["costUsd"]
            partial = d.get("partial") is True
            costs = [r["costUsd"] + (r["judgeCostUsd"] if _num(r.get("judgeCostUsd")) else 0) for r in runs if _num(r.get("costUsd"))]
        except (OSError, ValueError, KeyError, TypeError, AttributeError):
            continue
        if _num(cost) and runs:
            out.append((float(cost), partial, costs))
    return out


def ceiling(cap, jobs, records):
    """(jobs, ceiling) to pass to the eval tool."""
    per_run = max((c for _, _, cs in records for c in cs), default=None)
    if jobs <= 1 or per_run is None:
        return 1, cap
    room = cap - (jobs - 1) * per_run
    if room < per_run:
        return 1, cap
    return jobs, round(room, 2)


def estimate(records):
    """One line: the mean and max cost of a full batch over the stored runs, with their count."""
    costs = [c for c, partial, _ in records if not partial]
    if len(costs) < MIN_RUNS:
        return "not measured yet"
    return f"mean ${sum(costs) / len(costs):.2f}, max ${max(costs):.2f} over {len(costs)} stored runs"


def verdict_module():
    loader = SourceFileLoader("eval_record", os.path.join(HERE, "eval-record"))
    spec = importlib.util.spec_from_loader("eval_record", loader)
    m = importlib.util.module_from_spec(spec); loader.exec_module(m)
    return m


class GitError(Exception):
    pass


def _git(repo, *args):
    done = subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True)
    if done.returncode != 0:
        raise GitError(f"git {' '.join(args[:2])} failed: {done.stderr.strip() or done.returncode}")
    return done.stdout


def green_heads(folder, branch, repo):
    """The heads of the stored records that are green (bin/eval-record's own verdict), were made on `branch` and are commits of `repo`.
    A record without a head or with another branch is ignored."""
    judge = verdict_module().is_green
    heads = []
    try:
        names = sorted(os.listdir(folder))
    except OSError:
        return heads
    for name in names:
        if not name.endswith(".json"):
            continue
        try:
            d = json.load(open(os.path.join(folder, name), encoding="utf-8"))
            head, ok = d.get("head"), judge(d)
        except (OSError, ValueError, KeyError, TypeError, AttributeError):
            continue
        if not isinstance(head, str) or not head or d.get("branch") != branch or not ok:
            continue
        if subprocess.run(["git", "-C", repo, "cat-file", "-e", head + "^{commit}"], capture_output=True).returncode == 0:
            heads.append(head)
    return heads


def due(folder, repo):
    """Lines to print: the commits on the default branch that touch the checked paths and that no green run's head contains."""
    branch = relay_git.default_branch(repo)
    if not branch:
        raise GitError("the default branch cannot be told")
    heads = green_heads(folder, branch, repo)
    cmd = ["log", "refs/heads/" + branch, "--format=%h %s"]
    if heads:
        cmd += ["--not", *heads]
    lines = _git(repo, *cmd, "--", *CHECKED_PATHS).splitlines()
    if not lines:
        return []
    if heads:
        return lines
    out = ["no green run recorded"]
    if len(lines) > SHOW_LIMIT:
        out.append(f"{len(lines)} commits in all, the newest {SHOW_LIMIT} listed")
        lines = lines[:SHOW_LIMIT]
    return out + lines


def default_dir(repo=None):
    home = os.path.expanduser(os.environ.get("RELAY_HOME") or "~/.relay")
    try:
        common = subprocess.run(["git", "-C", repo or ".", "rev-parse", "--path-format=absolute", "--git-common-dir"], capture_output=True, text=True, check=True).stdout.strip()
        repo = os.path.basename(os.path.dirname(common))
    except (OSError, subprocess.CalledProcessError):
        repo = "repo"
    return os.path.join(home, "evals", repo)


def money_command(a):
    today = a.today or datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%d")
    home = os.path.dirname(os.path.dirname(a.dir)) if a.dir else None  # --dir is evals/<repo>; its home holds evals/ and bench/
    bench = os.path.join(home, "bench") if home else None
    try:
        if a.cmd == "cap" and a.arg is not None:
            print(relay_paidcap.land_cap(float(a.arg)))   # one commit on the default branch; the value just landed, not this checkout's file
            return 0
        if a.cmd == "guard":
            if a.arg != "eval":
                print("paid-cost: guard takes: eval", file=sys.stderr)
                return 2
            line = relay_paidcap.check(today, relay_paidcap.eval_estimate(home), "plugin evals", home=home, bench=bench)
            if line:
                print(f"ci: {line}")
                return 1
            return 0
        limit = relay_paidcap.cap()
    except (ValueError, OSError) as e:
        print(f"paid-cost: {e}", file=sys.stderr)
        return 2
    if a.cmd == "cap":
        print(f"{limit:g}")
        return 0
    spent, runs = relay_paidcap.spend_today(today, home, bench)
    print(f"{today}: spent ${spent:.2f} of the ${limit:g} cap, {runs} run{'s' if runs != 1 else ''}")
    return 0


def main(argv=None):
    ap = argparse.ArgumentParser()
    ap.add_argument("cmd", choices=["ceiling", "estimate", "due", "today", "cap", "guard"])
    ap.add_argument("arg", nargs="?")
    ap.add_argument("--today", help="the UTC day as YYYY-MM-DD (default: now)")
    ap.add_argument("--cap", type=float)
    ap.add_argument("--jobs", type=int, default=1)
    ap.add_argument("--within-day", action="store_true", help="ceiling: cap the --cap at what is left of the day's cap")
    ap.add_argument("--dir")
    ap.add_argument("--repo", default=".")
    a = ap.parse_args(argv)
    if a.cmd in ("today", "cap", "guard"):
        return money_command(a)
    if a.cmd == "due":
        try:
            lines = due(a.dir or default_dir(a.repo), a.repo)
        except GitError as e:
            print(f"paid-cost: {e}", file=sys.stderr)
            return 1
        if lines:
            print("\n".join(lines))
        return 0
    records = stored(a.dir or default_dir(a.repo))
    if a.cmd == "estimate":
        print(estimate(records))
        return 0
    if a.cap is None or a.cap <= 0 or a.jobs < 1:
        print("paid-cost: ceiling needs --cap above 0 and --jobs of 1 or more", file=sys.stderr)
        return 2
    if a.within_day:   # the batch may not push the day past the cap: its ceiling is at most the room the day has left
        today = a.today or datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%d")
        home = os.path.dirname(os.path.dirname(a.dir)) if a.dir else None
        try:
            room = relay_paidcap.cap() - relay_paidcap.spend_today(today, home)[0]
        except (ValueError, OSError) as e:
            print(f"paid-cost: {e}", file=sys.stderr)
            return 2
        a.cap = min(a.cap, round(room, 2))
        if a.cap <= 0:
            print("paid-cost: the day's cap leaves no room for a batch", file=sys.stderr)
            return 2
    jobs, c = ceiling(a.cap, a.jobs, records)
    print(jobs, f"{c:g}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
