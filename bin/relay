#!/usr/bin/env python3
# size: over the 600-line limit until its split item lands
"""relay: the owner's one command for the system of work.

  relay status                       what is running now, context sizes, running agents
  relay report [--since 7d] [--today] [--session <id>]
                                     where the money went: by model, by agent type, by session
  relay report --compare <A> <B>     two periods side by side (e.g. 2026-10-10..2026-10-13 2026-10-14..2026-10-17)
  relay calibrate                    copy Claude Code's own per-session totals into the ledger, then show
                                     transcripts vs exact per model and the fitted estimate settings
  relay improve suggest [--since 7d] measured anti-patterns, each with its saving and the lever that fixes it
  relay improve adopt <profile>      make a candidate the active profile (after a bench), sync, log why
  relay improve log                  the history of adopted changes and their bench results
  relay bench <profileA> <profileB> [--scenario <name>...|--tag <tag>] [--runs N] [--max-cost N] [--isolate] [--keep]
                                     the same work under two setups: quality, cost, time, turns side by side
                                     (--isolate: a throwaway config dir, so only the profiles differ; --keep: keep workspaces)
  relay bench active --set models.build=haiku --set effort.build=low
                                     try a change without writing a profile: B is A with these keys changed
  relay bench list                   past bench results
  relay candidate <name> [--copy delegate,front] [--set k=v]
                                     a candidate to edit by hand: copies of plugins whose agents or skills change
  relay profile [<name>]             show the active profile, or a candidate
  relay sync [--dry] [--adopt <target>]
                                     write ~/.claude/CLAUDE.md, each project's CLAUDE.local.md, agent models;
                                     refuses while `bin/paid-cost due` lists changes no green paid run covers
  relay install [--no-claude]
                                     this machine onto relay: global CLAUDE.md, user settings, plugins
  relay migrate --all [--apply] [--primary]      the migration plan (or the move) for every known project
  relay setup --global [--no-claude]  the user's files, once per machine (same as relay install)
  relay setup [<dir>] [--specs openspec|none]
              [--off <name@marketplace>]... [--license <SPDX id> [--holder <name>]]
                                     a project onto relay (new or existing; nothing deleted; writes only the project)
                                     --off turns a plugin of another marketplace off for this project (repeat for several)
                                     --license writes LICENSE and kit.toml [license]; without it nothing about licenses is written
  relay license add <SPDX id> [--holder <name>] [--year YYYY] [--headers code|config|docs] [-C <dir>]
                                     write LICENSE, LICENSES/<id>.txt, REUSE.toml and kit.toml [license] from the bundled exact
                                     text (refuses to overwrite a different one); --headers (repeatable or a comma list) adds
                                     the one-line SPDX header to the files of those groups
  relay license check [-C <dir>]     LICENSE, LICENSES/<id>.txt, REUSE.toml, tracked vendored folders and, with kit.toml
                                     [license] headers = [...], the headers; one line per problem, exit 1 when there is one.
                                     relay gate runs it when kit.toml has [license]
  relay setup --relay-folder [<dir>] write .relay/README.md only (nothing else); the only form run for relay itself
  relay migrate [<dir>] [--apply]    an existing project from the old agents/skills/hooks; --apply moves them aside
  relay doctor [<dir>]               check-up of the machine, the rules, the ledger, and a project
  relay flows                        the task flows available and what each needs
  relay rules                        the catalogue of rules with gists
  relay changed [-C <repo>] [--own] [--archive] <sha> [<until>]
                                     the files changed since <sha> (to <until>, default HEAD) that are not on the
                                     inert list (handover, queue and check files): what a check of a fix looks at;
                                     --own leaves out the files only the default branch changed;
                                     --archive also leaves out what a commit that only archives an OpenSpec change touches
  relay gate [-C <worktree>] [--paid] [--again] [-- <args>]
                                     run the project's quick (free) gate on the committed task branch and commit its log;
                                     --paid runs the full gate, paid evals included (bin/ci prints the estimate and the
                                     day's spend first); -- <args> names the gate's own mode (the cycle passes --quick);
                                     --again runs it although the same code has a finished gate (a red one is otherwise reported, not run)
                                     (.relay/checks/<sha>.gate.log); exits with the gate's status
                                     (a quick gate stopped at its time limit exits 124: run it again)
  relay land <branch> [-C <repo>] | --stats [--since <date>] [--until <date>]
                                     take the default branch into the branch, gate the result, fast-forward on green; one
                                     landing at a time, no agent (0 landed, 1 red, 2 refused, 3 take conflict, 4 run again);
                                     --stats prints the counters computed from its events and git
  relay precheck [-C <worktree>]     the gate's quick steps (types and lint, python 3.9 imports, plugin lib links on HEAD,
                                     changed tests and the rules registry test under python3), read-only; the quiet check a worker loops on starts with it; exits 1 when one is red
  relay check show [-C <repo>] [--brief] <branch>
                                     three lines: the branch's gate, check mark and outside findings; waits (at most
                                     10 s) while the branch's worktree is committing a mark
  relay check show [-C <repo>] [--brief] <report.json | sha>
                                     a recorded review or check printed as readable text (all of it, or with --brief
                                     the 10-line summary); a sha shows the stored check record of that commit
  relay check findings [-C <worktree>] [--item <slug>] [--review <review.json> ...]
                                     the findings a check must give a verdict for, with their ids (Q1 the queue item, F the
                                     reviews' findings, M merges of the default branch since the last check); a merge train
                                     (a branch that holds ready changes) needs no review: only its M findings
  relay check record review|check --input <file.toml>
                                     a judge's way to write its verdict (a check is ONE record: see roles/judge.md): the TOML input names the report (a .json path)
                                     and holds the fields and prose; validated, then written as JSON (agents never type
                                     JSON and pass no text through the shell); see roles/judge.md for the template
  relay check migrate [--redo] [-C <repo>]    convert the old (schema 1) checks in .relay/checks to check records, then delete the
                                     review sets; safe to run again (nothing to convert, nothing changed);
                                     --redo converts again from the checks as they were before this branch's migration commit
  relay check owner <review.json> <id> --input <file.toml>
                                     keep the owner's word that finding <id> is not wrong: the TOML holds `words` (the owner's
                                     words as said, '''...''' for several lines); appended with the date to the review's
                                     `owner` list; a checker counts that finding as not wrong; show prints it.
                                     With `queue = "<slug>"` in the TOML the word is that the finding moved to that queue
                                     item (it must be on the default branch): it counts under `queued`, not `open`
  relay queue [count|show|history|check|migrate|land|ip|take|release|done|drop|add|note|edit] ...
                                     the work queue (.relay/queue/ on the default branch): `relay queue` lists it,
                                     `relay queue count` gives the one-line count; see `relay queue -h`

The repository root is this script's parent, or $RELAY_ROOT.
"""

import datetime as dt
import os
import re
import subprocess
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(os.path.dirname(HERE), "lib"))

import relay_analyze  # noqa: E402
import relay_bench  # noqa: E402
import relay_checks_migrate  # noqa: E402
import relay_config  # noqa: E402
import relay_gate  # noqa: E402
import relay_git  # noqa: E402
import relay_inert  # noqa: E402
import relay_land  # noqa: E402
import relay_land_counters  # noqa: E402
import relay_lanes  # noqa: E402
import relay_ledger  # noqa: E402
import relay_precheck  # noqa: E402
import relay_license  # noqa: E402
import relay_marks  # noqa: E402
import relay_verdict  # noqa: E402
import relay_queue  # noqa: E402
import relay_queue_migrate  # noqa: E402
import relay_rules  # noqa: E402
import relay_setup  # noqa: E402
import relay_tidy  # noqa: E402

ROOT = relay_config.ROOT


class Usage(Exception):
    pass


def parse_span(text):
    """'7d', '12h', 'today', '2026-10-10', '2026-10-10..2026-10-13' -> (since, until) aware datetimes."""
    now = dt.datetime.now(dt.timezone.utc)
    if text in ("today",):
        start = now.replace(hour=0, minute=0, second=0, microsecond=0)
        return start, None
    m = re.fullmatch(r"(\d+)([dh])", text)
    if m:
        n, unit = int(m.group(1)), m.group(2)
        return now - (dt.timedelta(days=n) if unit == "d" else dt.timedelta(hours=n)), None
    if ".." in text:
        a, b = text.split("..", 1)
        return _day(a), _day(b) + dt.timedelta(days=1)
    return _day(text), _day(text) + dt.timedelta(days=1)


def _day(text):
    return dt.datetime.strptime(text, "%Y-%m-%d").replace(tzinfo=dt.timezone.utc)


def flag(args, name, default=None, takes_value=True):
    if name in args:
        i = args.index(name)
        if takes_value:
            value = args[i + 1]
            del args[i:i + 2]
            return value
        del args[i]
        return True
    return default


def flags(args, name):
    """Every value of a repeated `name <value>` flag, removed from args; Usage when one has no value."""
    values = []
    while name in args:
        i = args.index(name)
        if i + 1 >= len(args) or args[i + 1].startswith("--"):
            raise Usage(f"{name} needs a value")
        values.append(args[i + 1])
        del args[i:i + 2]
    return values


def cmd_status(args):
    since = dt.datetime.now(dt.timezone.utc) - dt.timedelta(hours=12)
    events = relay_ledger.read(since=since)
    if not events:
        print("No ledger events in the last 12 hours. Is the observe plugin enabled? (`relay doctor`)")
        return 0
    print(relay_analyze.status(events, relay_config.claude_dir()))
    return 0


def cmd_report(args):
    if "--compare" in args:
        i = args.index("--compare")
        a, b = args[i + 1], args[i + 2]
        sa, ua = parse_span(a)
        sb, ub = parse_span(b)
        da = relay_analyze.collect(relay_config.claude_dir(), sa, ua)
        db = relay_analyze.collect(relay_config.claude_dir(), sb, ub)
        print(f"# {a} vs {b} (per-turn figures are the fair ones)\n")
        print(relay_analyze.compare(da, db, a, b))
        return 0
    session = flag(args, "--session")
    if flag(args, "--today", takes_value=False):
        since, until = parse_span("today")
    else:
        since, until = parse_span(flag(args, "--since", "7d"))
    data = relay_analyze.collect(relay_config.claude_dir(), since, until, session_ids={session} if session else None)
    if not data["sessions"]:
        print("No sessions found in that period under " + os.path.join(relay_config.claude_dir(), "projects"))
        return 0
    print(relay_analyze.report(data))
    found = relay_analyze.findings(data)
    if found:
        print("\n## What to change (run `relay improve suggest` for the full list)")
        for f in found[:3]:
            print(f"- {f['id']} {f['title']}: {f['evidence']}" + (f"; about ${f['saving_usd']:.2f} to save" if f['saving_usd'] else ""))
    return 0


def cmd_calibrate(args):
    now = dt.datetime.now(dt.timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")
    print(relay_analyze.calibrate(relay_config.claude_dir(), now))
    return 0


def cmd_improve(args):
    sub = args[0] if args else "suggest"
    rest = args[1:]
    if sub == "suggest":
        since, until = parse_span(flag(rest, "--since", "7d"))
        data = relay_analyze.collect(relay_config.claude_dir(), since, until)
        found = relay_analyze.findings(data)
        t = relay_analyze.totals(data)
        total = t["main"].cost + t["agents_total"].cost
        print(f"# Suggestions from the last period ({t['sessions']} sessions, {t['agents']} agents, about ${total:.2f})\n")
        if not found:
            print("Nothing measured stands out. Add a bench scenario for what you want better, then `relay bench`.")
            return 0
        for n, f in enumerate(found, 1):
            saving = f" About ${f['saving_usd']:.2f} of ${total:.2f}." if f["saving_usd"] else ""
            print(f"{n}. {f['title']}\n   Measured: {f['evidence']}.{saving}\n   Lever: {f['lever']}\n")
        print("Pick one, write it into profiles/candidates/<name>.toml (or a rule), then:\n"
              "  relay bench active <name>        # same work, both setups, side by side\n"
              "  relay improve adopt <name>       # if the verdict says so")
        return 0
    if sub == "adopt":
        if not rest:
            raise Usage("relay improve adopt <profile>")
        name = rest[0]
        reason = flag(rest, "--because", "")
        profile = relay_bench.load_profile(name)
        active = os.path.join(ROOT, "profiles", "active.toml")
        previous = relay_bench.load_profile("active")
        stamp = dt.datetime.now().strftime("%Y-%m-%d %H:%M")
        history = os.path.join(ROOT, "profiles", "history")
        refused = []
        for entry in profile.get("plugins", {}).get("enabled", []):
            folder = relay_bench.plugin_dir(profile, entry)
            if folder and folder.startswith(os.path.join(ROOT, "profiles", "candidates")):
                refused += relay_bench.lib_adoption_conflicts(folder, os.path.join(ROOT, "plugins", os.path.basename(folder)))
        if refused:   # before anything is written
            print("relay improve adopt: " + "\n".join(refused), file=sys.stderr)
            return 1
        os.makedirs(history, exist_ok=True)
        import shutil
        shutil.copy2(active, os.path.join(history, f"{stamp.replace(' ', 'T').replace(':', '-')}-{previous['profile']['name']}.toml"))
        # A candidate that carries edited plugin copies: they become the plugins, the originals are kept.
        import shutil as _sh
        enabled = list(profile.get("plugins", {}).get("enabled", []))
        for i, entry in enumerate(enabled):
            folder = relay_bench.plugin_dir(profile, entry)
            if folder and folder.startswith(os.path.join(ROOT, "profiles", "candidates")):
                plugin = os.path.basename(folder)
                keep = os.path.join(history, f"{stamp.replace(' ', 'T').replace(':', '-')}-plugins-{plugin}")
                _sh.copytree(os.path.join(ROOT, "plugins", plugin), keep, dirs_exist_ok=True)
                for sub in ("agents", "skills", "hooks", "lib", "bin"):
                    src = os.path.join(folder, sub)
                    if os.path.isdir(src):
                        if sub == "lib":
                            relay_bench.adopt_lib(src, os.path.join(ROOT, "plugins", plugin, sub))
                        else:
                            _sh.copytree(src, os.path.join(ROOT, "plugins", plugin, sub), dirs_exist_ok=True)
                enabled[i] = plugin
                print(f"plugins/{plugin}: replaced by the candidate's copy (previous in {keep})")
        profile["plugins"]["enabled"] = enabled
        text = relay_bench.to_toml(profile)
        text = re.sub(r'(?m)^name = ".*"$', 'name = "active"', text, count=1)
        header = f"# Active profile, adopted {stamp} from {name}" + (f": {reason}" if reason else "") + "\n# Previous: profiles/history/. Change only through `relay improve adopt`.\n\n"
        with open(active, "w", encoding="utf-8") as handle:
            handle.write(header + text.lstrip("\n"))
        last = relay_bench.list_results(limit=1)
        bench_ref = last[0][0] if last else "no bench recorded"
        with open(os.path.join(ROOT, "improve", "log.md"), "a", encoding="utf-8") as handle:
            handle.write(f"\n## {stamp}: adopted {name}\n- was: {previous['profile']['name']} ({previous['profile'].get('description', '')})\n"
                         f"- now: {profile['profile'].get('description', '')}\n- bench: {bench_ref}\n- because: {reason or '(not given)'}\n")
        try:
            results = relay_rules.sync(relay_config.active_profile())
        except relay_rules.Held as held:
            print(f"Adopted {name} as the active profile; previous kept in profiles/history/. The sync is held, "
                  "it waits for a green paid run; merged since the last one:\n" + str(held), file=sys.stderr)
            return 1
        print(f"Adopted {name} as the active profile; previous kept in profiles/history/. Synced:")
        for n, path, state in results:
            print(f"  {n}: {state} ({path})")
        print("Restart Claude Code sessions for the new agent models to apply.")
        return report_refused(results)
    if sub == "log":
        path = os.path.join(ROOT, "improve", "log.md")
        print(open(path, encoding="utf-8").read() if os.path.isfile(path) else "No adoptions yet.")
        return 0
    raise Usage("relay improve suggest|adopt <profile>|log")


def cmd_bench(args):
    if args and args[0] == "list":
        for name, doc in relay_bench.list_results():
            agg = relay_bench.aggregate(doc)
            profiles = [p["name"] for p in doc["profiles"]]
            summary = "; ".join(f"{p}: " + ", ".join(f"{s} {agg.get((p, s), {}).get('score_mean', 0):.2f}/${agg.get((p, s), {}).get('cost_mean') or 0:.2f}" for s in doc["scenarios"]) for p in profiles)
            print(f"{name}  {summary}" + ("  PARTIAL" if doc.get("partial") else ""))
        return 0
    runs = flag(args, "--runs")
    max_cost = flag(args, "--max-cost")
    tag = flag(args, "--tag")
    keep = flag(args, "--keep", takes_value=False)
    judge = flag(args, "--judge-model", "haiku")
    out_root = flag(args, "--out")
    isolate = flag(args, "--isolate", takes_value=False)
    scenarios = []
    while "--scenario" in args:
        scenarios.append(flag(args, "--scenario"))
    sets = []
    while "--set" in args:
        sets.append(flag(args, "--set"))
    names = args
    if len(names) < 1:
        raise Usage("relay bench <profileA> [<profileB> | --set key=value ...] [--scenario <name>...] [--tag <tag>] [--runs N] [--max-cost USD]")
    profiles = [relay_bench.load_profile(n) for n in names]
    if sets:
        profiles.append(relay_bench.derive_profile(profiles[0], sets))
    chosen = [relay_bench.load_scenario(s) for s in scenarios] if scenarios else relay_bench.list_scenarios(tag=tag)
    if not chosen:
        raise Usage("no scenarios: add evals/scenarios/<name>/scenario.toml or pass --scenario")
    est = len(profiles) * sum(int(runs) if runs else s.get("runs", 1) for s in chosen)
    print(f"Running {len(chosen)} scenario(s) x {len(profiles)} profile(s): {est} headless sessions (each a real model call).")
    try:
        out_dir, doc, text = relay_bench.run_bench(profiles, chosen, runs=int(runs) if runs else None, judge_model=judge,
                                                   keep=bool(keep), out_root=out_root, max_cost_usd=float(max_cost) if max_cost else None, isolate=bool(isolate))
    except (relay_bench.PaidCapReached, ValueError) as exc:
        print(f"relay: {exc}", file=sys.stderr)
        return 1
    print(text)
    print(f"\nSaved: {out_dir}/report.md and results.json")
    return 0


def cmd_candidate(args):
    copies = []
    while "--copy" in args:
        copies += [c.strip() for c in flag(args, "--copy").split(",") if c.strip()]
    sets = []
    while "--set" in args:
        sets.append(flag(args, "--set"))
    base = flag(args, "--from", "active")
    if not args:
        raise Usage("relay candidate <name> [--from <profile>] [--copy delegate,front] [--set key=value]")
    name = args[0]
    out, copied = relay_bench.new_candidate(name, base, copies, sets)
    print(f"Candidate {name}: {out['profile']['description']}\n  profile: {out['_path']}")
    for c in copied:
        print(f"  edit the copy: {c}  (agents/*.md, skills/*/SKILL.md)")
    print(f"  then: relay bench active {name} --tag cheap")
    return 0


def cmd_profile(args):
    name = args[0] if args else "active"
    p = relay_bench.load_profile(name)
    print(f"# {p['profile']['name']}: {p['profile'].get('description', '')}  ({p['_path']})")
    print(f"front: {p.get('session', {}).get('model')} at effort {p.get('session', {}).get('effort')}")
    print("tiers:")
    for tier in relay_bench.TIERS:
        print(f"  {tier:6} {p.get('models', {}).get(tier, '-'):8} effort {p.get('effort', {}).get(tier, '-')}")
    print("rules loaded: " + ", ".join(p.get("rules", {}).get("load", [])))
    print("plugins: " + ", ".join(p.get("plugins", {}).get("enabled", [])))
    others = [f[:-5] for f in os.listdir(os.path.join(ROOT, "profiles", "candidates")) if f.endswith(".toml")]
    if name == "active" and others:
        print("candidates: " + ", ".join(sorted(others)) + "  (compare: relay bench active <candidate>)")
    return 0


def cmd_sync(args):
    dry = flag(args, "--dry", takes_value=False)
    adopt = flag(args, "--adopt")
    only = set(args) or None
    try:
        results = relay_rules.sync(relay_config.active_profile(), only=only, adopt=adopt, dry=bool(dry))
    except relay_rules.Held as held:
        print("relay sync: waits for a green paid run; merged since the last one:\n" + str(held), file=sys.stderr)
        return 1
    for name, path, state in results:
        print(f"{name}: {state} ({path})")
    return report_refused(results)


def report_refused(results):
    """Exit status for a sync: 1 and the refused targets named when any was refused."""
    names = relay_rules.refused(results)
    if names:
        print("relay sync: refused " + ", ".join(names) + "; every other target was written. "
              "Take one over with `relay sync --adopt <target>`.", file=sys.stderr)
        return 1
    return 0


def cmd_setup(args, migrate=False):
    if migrate and "--all" in args:
        args.remove("--all")
        return cmd_migrate_all(args)
    if "--relay-folder" in args:
        args.remove("--relay-folder")
        if migrate or any(a.startswith("--") for a in args) or len(args) > 1:
            raise Usage("--relay-folder takes only an optional folder: relay setup --relay-folder [<dir>]")
        root = os.path.realpath(args[0] if args else os.getcwd())
        if not os.path.isdir(root):
            raise Usage(f"no such folder: {root}")
        path, created = relay_setup.relay_folder(root)
        print(f"{path}: " + ("written" if created else "already there, nothing changed"))
        return 0
    if flag(args, "--global", takes_value=False):   # before the project flags are taken out, so none is dropped silently
        if migrate or any(a != "--no-claude" for a in args):
            raise Usage("--global takes nothing else: relay setup --global [--no-claude]")
        return cmd_install(args)
    apply = flag(args, "--apply", takes_value=False)
    specs = flag(args, "--specs")
    off = flags(args, "--off")
    if off and migrate:
        raise Usage("--off is a setup flag: relay setup <dir> --off <name@marketplace>")
    license_id = flag(args, "--license")
    holder = flag(args, "--holder")
    if holder is not None and license_id is None:
        raise Usage("--holder goes with --license <SPDX id>")
    unknown = [a for a in args if a.startswith("--")]
    if unknown:
        raise Usage(f"unknown flag {unknown[0]} (the user's files are written only by `relay setup --global`)")
    root = os.path.realpath(args[0] if args else os.getcwd())
    if not os.path.isdir(root):
        raise Usage(f"no such folder: {root}")
    name = relay_setup.detect(root)["name"]
    if name in relay_setup.RESERVED_NAMES:   # relay sync would take the name for the user's own target and write ~/.claude
        raise Usage(f"a project folder cannot be named {name!r} (relay sync's own target of that name writes the user's files): use another folder name")
    if migrate:
        d, items, moved, flow, done, todo = relay_setup.migrate(root, apply=bool(apply), specs=specs)
        print(f"# {d['name']} ({root}): migration" + (" applied" if apply else " plan (nothing moved; add --apply)"))
        if items:
            print("\nThe old setup had, and relay replaces with:")
            for kind, path, target, note in items:
                print(f"- {kind} {path} -> {target}; {note}")
        else:
            print("\nNo old agents, skills, hooks or scripts to replace.")
        if moved:
            print("\nMoved aside (revert with mv):")
            for src, dst in moved:
                print(f"- {src} -> {dst}")
    else:
        d, flow, done, todo = relay_setup.setup(root, specs=specs, license_id=license_id, holder=holder, off=off)
        print(f"# {d['name']} ({root}): set up")
    print(f"\nDetected: {d['stack']} ({d['tool'] or 'no tool'}), default branch {d['default_branch']}, flow {flow}.")
    print("\nDone:")
    for item in done:
        print(f"- {item}")
    if todo:
        print("\nYours to do (only what the setup cannot know):")
        for n, item in enumerate(todo, 1):
            print(f"{n}. {item}")
    if relay_setup.main_checkout(root):
        # the project's CLAUDE.local.md lives in the main checkout; a worktree's setup writes nothing outside the worktree
        print("\nNot synced from a worktree: run `relay sync` after this branch is merged into the default branch.")
        print("\nCheck: relay doctor " + root)
        return 0
    try:
        results = relay_rules.sync(relay_config.active_profile(), only={d["name"]}, adopt=d["name"])
    except relay_rules.Held:
        print("\nNot synced: waits for a green paid run (the setup itself is done); run `relay sync` after it.", file=sys.stderr)
        print("\nCheck: relay doctor " + root)
        return 0
    print("\nSynced: " + "; ".join(f"{n} {state}" for n, _, state in results))
    print("\nCheck: relay doctor " + root)
    return report_refused(results)


def cmd_install(args):
    no_claude = flag(args, "--no-claude", takes_value=False)
    done, todo = relay_setup.install(run_claude=not no_claude)
    print("# relay install\n\nDone:")
    for d in done:
        print(f"- {d}")
    if todo:
        print("\nYours to do:")
        for n, t in enumerate(todo, 1):
            print(f"{n}. {t}")
    print("\nNext: `relay setup <dir>` to add a project, then `relay doctor`.")
    return 0


def cmd_migrate_all(args):
    apply = flag(args, "--apply", takes_value=False)
    principles = flag(args, "--principles", "~/principles")
    primary = flag(args, "--primary", takes_value=False)
    projects = relay_setup.known_projects()
    if not projects:
        print("No projects registered (relay setup <dir> adds one).")
        return 0
    for name, root, exists in projects:
        print(f"\n==== {name} ({root})")
        if not exists:
            print("  folder missing: skipped")
            continue
        if not primary and os.path.isdir(os.path.join(root, ".git")):   # .git is a folder only in a primary checkout
            print("  primary checkout: skipped (a reviewer's probe once wrote into one); add --primary to migrate it")
            continue
        copied = relay_setup.copy_kit_drafts(principles, name, root)
        if copied:
            print(f"  kit drafts from principles/migration/{name}: " + ", ".join(copied))
        d, items, moved, flow, done, todo = relay_setup.migrate(root, apply=bool(apply))
        print(f"  flow {flow}; {len(items)} old files " + ("moved aside" if apply else "to move (add --apply)"))
        for kind, path, target, note in items:
            print(f"  - {kind} {path} -> {target}")
        for t in todo:
            if "plugin marketplace" not in t:
                print(f"  todo: {t}")
    print("\nThen: relay sync; relay doctor <dir> for each.")
    return 0


def cmd_doctor(args):
    root = os.path.realpath(args[0]) if args else None
    machine, project = relay_setup.doctor_parts(root, profile=relay_config.active_profile())

    def show(checks):
        for name, good, detail in checks:
            print(f"{'ok  ' if good else 'FIX '} {name}" + (f"  ({detail})" if detail and not good else ""))
        return sum(not good for _, good, _ in checks)

    # With a project folder only its checks and its repository's tidy lines decide the exit code: the machine-wide ones
    # (the user's settings, the rules of every project) say nothing about this project, so they print apart.
    tidy = relay_tidy.lines(root or os.getcwd())   # no folder given: the repository of the current folder (none: no lines)
    if root:
        print(f"# Project {root}")
        bad = show(project)
    else:
        print("# This machine")
        bad = show(machine)
    good = len(project if root else machine) - bad
    for fix, text in tidy:
        print(f"{'FIX ' if fix else 'note'} {text}")
        bad += fix
    print(f"\n{good} ok, {bad} to fix")
    if root:
        print("\n# This machine (does not change this project's exit code)")
        other = show(machine)
        print(f"\n{len(machine) - other} ok, {other} to fix")
    return 1 if bad else 0


def cmd_flows(args):
    for m in relay_setup.list_flows():
        print(f"# {m['kind']} (plugin {m['plugin']}, {m.get('slot', 'work')}): {m['description']}")
        print("  stages: " + ", ".join(f"{s['name']} ({', '.join(s['triggers'])} -> {s.get('skill') or 'note'})" for s in m["stages"]))
        if m.get("steps"):
            print("  steps: " + ", ".join(f"{s['at']}: {s['does']}" for s in m["steps"]))
        print("  needs plugins: " + ", ".join(m.get("requires_plugins", [])) + "; bindings: " + ", ".join(m.get("bindings_required", [])))
        print()
    print("Bind where work comes from in .claude/kit.toml: [flow] kind = \"<kind>\"; turn spec steps on with [specs] method = \"<plugin>\" "
          "(`relay setup <dir> --specs <plugin>`). A new flow or spec method is a plugin with a flow.json (docs/flows.md).")
    return 0


def cmd_rules(args):
    profile = relay_config.active_profile()
    loaded = set(profile.get("rules", {}).get("load", []))
    for name, rule in relay_rules.rules().items():
        print(f"{'LOADED ' if name in loaded else 'gist   '} {name:16} {rule['gist']}")
    return 0


def cmd_changed(args):
    usage = "relay changed [-C <repo>] [--own] [--archive] <sha> [<until>]"
    repo, own, archive, rest = ".", False, False, []
    args = list(args)
    while args:
        arg = args.pop(0)
        if arg == "-C" and args:
            repo = args.pop(0)
        elif arg == "--own":
            own = True
        elif arg == "--archive":
            archive = True
        elif arg.startswith("-"):
            raise Usage(usage)
        else:
            rest.append(arg)
    if len(rest) not in (1, 2):
        raise Usage(usage)
    repo, until = os.path.realpath(repo), rest[1] if len(rest) == 2 else "HEAD"
    held = relay_inert.absorbed(repo, until) if own else None        # the ready changes a train holds are not its own files
    for path in relay_inert.changed(repo, rest[0], until, own=own, archive=archive, absorbed=held):
        print(path)
    return 0


def _print_paid_cost(worktree):
    """To stderr, before a --paid gate starts: the estimate and the day's spend of the project's bin/paid-cost, when it has one."""
    tool = os.path.join(worktree, "bin", "paid-cost")
    if not os.access(tool, os.X_OK):
        return
    for word in ("estimate", "today"):
        try:
            done = subprocess.run([tool, word], cwd=worktree, capture_output=True, text=True, timeout=60)
        except (OSError, subprocess.TimeoutExpired):
            continue
        if done.returncode == 0 and done.stdout.strip():
            print("paid: " + done.stdout.strip(), file=sys.stderr, flush=True)


def cmd_gate(args):
    usage = "relay gate [-C <worktree>] [--paid] [--again] [-- <args>]"
    args, extra = list(args), []
    if "--" in args:
        i = args.index("--")
        args, extra = args[:i], args[i + 1:]
    paid = "--paid" in args
    again = "--again" in args
    args = [a for a in args if a not in ("--paid", "--again")]
    if paid and extra:
        raise Usage(usage + ": --paid and -- <args> do not go together")
    quick = not paid and not extra      # the plain gate is the free one (gate.ci_quick, when kit.toml names it); the paid evals need --paid
    worktree = "."
    if len(args) == 2 and args[0] == "-C":
        worktree = args[1]
    elif args:
        raise Usage(usage)
    if paid:
        _print_paid_cost(worktree)
    try:
        code, log, red = relay_gate.run(worktree, extra, quick=quick, again=again)
    except relay_gate.GateRefused as exc:
        raise ValueError(str(exc))
    print("gate %s: exit %d" % (os.path.basename(log)[:-len(".gate.log")], code))
    print(log)
    for line in red:
        print(line)
    return code


def cmd_land(args):
    usage = "relay land <branch> [-C <repo>] | relay land --stats [--since <date>] [--until <date>] [-C <repo>]"
    args = list(args)
    repo = "."
    if "-C" in args:
        i = args.index("-C")
        if i + 1 >= len(args):
            raise Usage(usage)
        repo = args[i + 1]
        del args[i:i + 2]
    if "--stats" in args:
        args.remove("--stats")
        window = {}
        for flag in ("--since", "--until"):
            if flag in args:
                i = args.index(flag)
                if i + 1 >= len(args):
                    raise Usage(usage)
                window[flag[2:]] = args[i + 1]
                del args[i:i + 2]
        if args:
            raise Usage(usage)
        print("\n".join(relay_land_counters.stats(repo, window.get("since"), window.get("until"))))
        return 0
    if len(args) != 1 or args[0].startswith("-"):
        raise Usage(usage)
    result = relay_land.land(repo, args[0], lambda line: print("land: " + line, file=sys.stderr, flush=True))
    print("\n".join(result.lines))
    return result.code


def cmd_metrics(args):
    import relay_metrics
    return relay_metrics.main(args, os.getcwd())


def cmd_precheck(args):
    usage = "relay precheck [-C <worktree>]"
    if args and not (len(args) == 2 and args[0] == "-C"):
        raise Usage(usage)
    code, lines = relay_precheck.run(args[1] if args else ".")
    print("\n".join(lines))
    return code


RECORD_USAGE = "relay check record review|check --input <file.toml>"
OWNER_USAGE = "relay check owner <review.json> <id> --input <file.toml>"


def _queue_has(slug):
    """Whether queue item `slug` is on the default branch of the repository in the current folder (open or taken)."""
    try:
        return any(i["slug"] == slug and not i["problems"] for i in relay_queue.read_queue(os.getcwd()))
    except relay_queue.Refused:
        return False


def cmd_check_owner(args):
    """relay check owner <review.json> <id> --input <file.toml>: keep the owner's word that a finding is not wrong."""
    if len(args) != 4 or args[2] != "--input" or args[3].startswith("--") or args[0].startswith("-") or args[1].startswith("-"):
        raise Usage(OWNER_USAGE)
    try:
        path = relay_verdict.add_owner(args[0], args[1], args[3], dt.date.today().isoformat(), queue_has=_queue_has)
    except relay_verdict.VerdictError as exc:
        raise ValueError(str(exc))
    print("recorded the owner's word on %s in %s" % (args[1], path))
    return 0


def cmd_check_record(args):
    """relay check record review|check --input <file.toml>: the input names the report and holds every field."""
    if len(args) != 3 or args[0] not in ("review", "check") or args[1] != "--input" or args[2].startswith("--"):
        raise Usage(RECORD_USAGE)
    try:
        record = relay_verdict.record_review if args[0] == "review" else relay_verdict.record_check
        path = record(args[2])
        counts = ""
        if args[0] == "check":
            with open(path, encoding="utf-8") as handle:
                data = relay_verdict.load_record(handle.read(), "the check record")
            counts = " (open %d, queued %d)" % (relay_verdict.open_of(data), relay_verdict.queued_of(data))
    except (relay_verdict.VerdictError, OSError) as exc:
        raise ValueError(str(exc))
    print("recorded %s%s" % (path, counts))
    return 0


FINDINGS_USAGE = "relay check findings [-C <worktree>] [--item <slug>] [--review <review.json> ...]"


def cmd_check_findings(args):
    """relay check findings: the findings the check must give a verdict for, built by the same code that records the check."""
    wt, reviews, item, args = ".", [], None, list(args)
    while args:
        arg = args.pop(0)
        if arg == "-C" and args:
            wt = args.pop(0)
        elif arg == "--item" and args:
            item = args.pop(0)
        elif arg == "--review" and args and not args[0].startswith("--"):
            reviews.append(os.path.abspath(args.pop(0)))
        else:
            raise Usage(FINDINGS_USAGE)
    try:
        print("\n".join(relay_verdict.finding_list(os.path.realpath(wt), reviews, item)))
    except relay_verdict.VerdictError as exc:
        raise ValueError(str(exc))
    return 0


MIGRATE_USAGE = "relay check migrate [--redo] [-C <repo>]"


def cmd_check_migrate(args):
    """relay check migrate: convert the schema-1 checks in <repo>/.relay/checks to check records; safe to run again."""
    args, repo = list(args), "."
    again = "--redo" in args
    if again:
        args.remove("--redo")
    if args[:1] == ["-C"] and len(args) == 2:
        repo = args[1]
    elif args:
        raise Usage(MIGRATE_USAGE)
    try:
        checks, marks, sets = relay_checks_migrate.migrate_and_commit(os.path.realpath(repo), again)
    except relay_checks_migrate.CommitError as exc:
        raise ValueError("%s" % exc)
    except relay_checks_migrate.MigrateError as exc:
        raise ValueError("nothing changed: %s" % exc)
    if not (checks or marks or sets):
        print("nothing to migrate")
    else:
        print("migrated %d checks and %d marks; deleted %d review sets" % (checks, marks, sets))
    return 0


def cmd_check(args):
    usage = ("relay check show [-C <repo>] [--brief] <branch | report.json | sha>  |  "
             "relay check record review|check --input <file.toml>  |  " + FINDINGS_USAGE + "  |  " + MIGRATE_USAGE + "  |  " + OWNER_USAGE)
    if args and args[0] == "record":
        return cmd_check_record(args[1:])
    if args and args[0] == "owner":
        return cmd_check_owner(args[1:])
    if args and args[0] == "findings":
        return cmd_check_findings(args[1:])
    if args and args[0] == "migrate":
        return cmd_check_migrate(args[1:])
    if not args or args[0] not in ("show",):
        raise Usage(usage)
    args, repo, rest, brief = list(args[1:]), ".", [], False
    while args:
        arg = args.pop(0)
        if arg == "-C" and args:
            repo = args.pop(0)
        elif arg == "--brief":
            brief = True
        elif arg.startswith("-"):
            raise Usage(usage)
        else:
            rest.append(arg)
    if len(rest) != 1:
        raise Usage(usage)
    args = rest
    try:
        print(show_check(os.path.realpath(repo), args[0], brief), end="")
    except (relay_marks.MarkError, relay_verdict.VerdictError) as exc:
        raise ValueError(str(exc))
    return 0


def show_check(repo: str, target: str, brief: bool) -> str:
    """The text of `relay check show`: a recorded JSON file or a stored sha rendered as a readable report, else the branch's three lines."""
    if os.path.isfile(target):
        with open(target, encoding="utf-8") as handle:
            return relay_verdict.render_any(handle.read(), brief, target, "the report %s" % target)
    if relay_git.git(repo, "rev-parse", "--verify", "-q", "refs/heads/" + target)[0] != 0 and re.fullmatch(r"[0-9a-f]{4,40}", target):
        texts = relay_marks.stored_texts(repo, target)
        return "\n".join(relay_verdict.render_any(t, brief, target, "the stored report of %s" % target) for t in texts)
    with relay_git.reading():
        return "\n".join(relay_marks.show(repo, target)) + "\n"


QUEUE_USAGE = """relay queue                              the ordered list: ip, kind, time, what, name
relay queue count                        "10 fix, 12 feature; top: <slug> (fix, ip 95, 30m)"
relay queue <view>                       a read-only view from relay's lib/queue_ext/ (also: relay queue --view <view>); `table` is the default, `json` prints the items for scripts
relay queue show <slug or words>         one item in full, with its notes; words (title, what, why, notes) find it: one match is shown, several are listed
relay queue history <slug>               the earlier text of an edited item, read from git
relay queue check                        every item file of this checkout is well formed; lists the ones that are not
relay queue migrate                      rewrite item files of the old shape (`state`) to dated events from git history, and move files out of the gone done/ folder; safe to run again
relay queue add --input <file.toml> [--time 20m|1h|1h30m] [--ip N]
                                         the TOML holds kind, title, why, time, what, failing_case, failing_kind, pass_cases, where (a list of places: ["lib/x.py:5-9 note", "docs/"])
                                         a fix says what its failing case is: failing_kind = "test", "run" (a recorded red run) or "claim" (someone's word)
                                         said = '''the owner's words, verbatim''' (optional): kept as a said note, never in the text
relay queue add --from <report.json> F<n> --input <file.toml> [--time ..] [--ip N]
                                         the finding F<n> of a recorded review or check; the TOML holds why, time, ip
relay queue note <slug> --input <file.toml>
                                         add a note to an item in any state: what the owner said, a fact, or a decision. The TOML holds ONE of
                                           said = '''the owner's words, verbatim'''
                                           fact = '''a measurement, with what and when'''
                                           question = '''the question block as you will show it''' + options = ["a. ...", "b. ..."]
                                             (the question opens with a bold title; the command prints the block back and its asked time: show the owner exactly the block)
                                           answer = '''the owner's whole reply, every explanation''' [+ to = ["<asked time>", ...]] [+ reading = '''your reading''']
                                             (to names the question(s) answered by the asked time `show` prints; without it the answer goes to the only waiting question)
                                         and, optional, at = "2026-10-27T01:20:00Z" (when it was said; default now). A note is only added, never edited.
relay queue edit <slug> --input <file.toml>
                                         correct one exact fragment of an item's text, in any state. The TOML holds
                                           field = "why"   (title, what, why, failing_case, failing_kind, pass_cases, where, time or test)
                                           old = '''the exact text to replace (found once in the field)'''
                                           new = '''the text that replaces it'''
                                           because = '''what was found, and when''' (becomes a dated fact note)
                                         Quoted text ("...", «...», '...') is never changed. `test` only on a closed item, to a test that exists.
                                         This is the only way to change an item's text; a hand edit is refused (guard and merge).
relay queue land <slug>                  try again to land a kept wt/queue-<slug>
relay queue ip <slug> <n>
relay queue take <slug> -C <worktree>   (a branch holds one fix item; the check states its problem as finding Q1)
relay queue release <slug>
relay queue start <slug> --scratch <folder>   makes the worktree, takes the item, writes its brief into <folder>/briefs and prints the cycle unit (JSON); refused when no lane is free or the item waits for a file another change holds (--despite-wait starts it anyway)
relay queue done <slug> -C <worktree> --test <file>::<name> | evals/<plugin|judge-measure>/<case>::<grader>   (a fix: the branch's newest check, with no own file changed since, has Q1 MET)
relay queue done <slug> --fixed-by <commit> --test <file>.py::<Class>::<name>   (a fix that a change already on the default branch fixed: the test is there and fails at the commit's parent; no branch of its own)
relay queue done <slug> --evidence <sha>   (a feature finished without a branch of relay's own; a fix is refused: it needs --test)
relay queue drop <slug> --input <file.toml>
                                         the TOML holds `why`: the owner's words (text in '''...''')
Every form takes [-C <repo>] (default: the current folder)."""


def _queue_options(args, spec):
    """Small option reader: spec maps `--name` to a type (str/int) or None for a flag; returns (options, positionals)."""
    opts, rest, i = {}, [], 0
    while i < len(args):
        a = args[i]
        if a in spec:
            if i + 1 >= len(args):
                raise Usage(f"{a} needs a value")
            try:
                opts[a] = spec[a](args[i + 1])
            except relay_queue.Refused as e:
                raise Usage(str(e))
            except ValueError:
                raise Usage(f"{a} needs a whole number")
            i += 2
        elif a.startswith("-") and len(a) > 1:
            raise Usage(f"unknown option {a}\n{QUEUE_USAGE}")
        else:
            rest.append(a)
            i += 1
    return opts, rest


QUEUE_WRITES = ("add", "land", "ip", "release", "drop", "take", "start", "done", "note", "edit")


def cmd_queue(args):
    sub = args[0] if args and not args[0].startswith("-") else ""
    rest = args[1:] if sub else args
    if sub in ("-h", "--help") or (args and args[0] in ("-h", "--help")):
        print(QUEUE_USAGE)
        return 0
    common = {"-C": str}
    if sub == "count":
        o, p = _queue_options(rest, common)
        if p:
            raise Usage(QUEUE_USAGE)
        print(relay_queue.count_text(relay_queue.read_queue(os.path.realpath(o.get("-C", ".")))))
        return 0
    if sub == "show":
        o, p = _queue_options(rest, common)
        if not p:
            raise Usage("relay queue show <slug or words>")
        query = " ".join(p)
        items = relay_queue.read_queue(os.path.realpath(o.get("-C", ".")), closed=True)
        found, how = relay_queue.find_for_show(items, query)
        if not found:
            bad = next((i for i in items if i["slug"] == query and i["problems"]), None)
            if bad:
                raise Usage(f"queue item '{query}' is malformed ({'; '.join(bad['problems'])})")
            raise Usage(f"no queue item '{query}' and no item with all these words in its title, what, why or notes; try fewer or other words (items are written in English)")
        if len(found) > 1:
            print(f"{len(found)} items match '{query}'; relay queue show <slug> prints one:")
            print("\n".join(relay_queue.match_lines(found)))
            return 0
        if how == "words":
            print(f"found by words '{query}':")
        print(relay_queue.show_text(found[0]))
        return 0
    if sub == "history":
        o, p = _queue_options(rest, common)
        if len(p) != 1:
            raise Usage("relay queue history <slug>")
        try:
            print(relay_queue.history(os.path.realpath(o.get("-C", ".")), p[0]))
        except relay_queue.Refused as e:
            raise Usage(str(e))
        return 0
    if sub in ("check", "migrate"):
        o, p = _queue_options(rest, common)
        if p:
            raise Usage(QUEUE_USAGE)
        folder = os.path.realpath(o.get("-C", "."))
        try:
            root = relay_queue._text(relay_queue._git(folder, "rev-parse", "--show-toplevel")[1]) or folder
            if sub == "migrate":
                done = relay_queue_migrate.migrate(root)
                moved = relay_queue_migrate.move_done_back(root)
                print(f"migrated {len(done)} item file(s) to dated events" + "".join(f"\n  {x}" for x in done) if done else "nothing to migrate: every item file has dated events")
                if moved:
                    print(f"moved {len(moved)} item file(s) out of done/ (staged; commit them alone, as renames)")
                return 0
            bad = relay_queue.check_files(root)
        except relay_queue.Refused as e:
            raise Usage(str(e))
        for path, reasons in bad:
            print(f"{path}: {'; '.join(reasons)}")
        if not bad:
            print("every queue item file is well formed")
        return 1 if bad else 0
    if sub not in QUEUE_WRITES:
        # a read-only view: `relay queue [--view] <name> [args]`, the table when no name is given
        name, extra, folder = ("table" if not sub else sub), [], "."
        if sub == "" and rest[:1] == ["--view"]:
            if len(rest) < 2:
                raise Usage("--view needs a view name")
            name, rest = rest[1], rest[2:]
        i = 0
        while i < len(rest):
            if rest[i] == "-C" and i + 1 < len(rest):
                folder, i = rest[i + 1], i + 2
            else:
                extra.append(rest[i])
                i += 1
        try:
            # `json` lists the closed and dropped items too, with all their dates; `estimate` the closed ones, to set their actual time beside the estimate
            if name == "estimate":
                extra = ["--root", os.path.realpath(folder)] + extra     # the view counts only this repo's worktrees
            return relay_queue.run_extension(name, relay_queue.read_queue(os.path.realpath(folder), closed=(name in ("json", "estimate"))), extra)
        except relay_queue.Refused as e:
            raise Usage(str(e))
    repo = lambda o: os.path.realpath(o.get("-C", "."))
    if sub == "add":
        o, p = _queue_options(rest, dict(common, **{"--from": str, "--input": str, "--kind": str, "--time": relay_queue.parse_time, "--ip": int}))
        if "--input" not in o:
            raise Usage(QUEUE_USAGE)
        from_report = "--from" in o
        if from_report and "--kind" in o:
            raise Usage("--kind does not go with --from: a finding is always queued as a fix")
        try:
            if from_report and len(p) != 1 or not from_report and p:
                raise Usage("relay queue add --from <report.json> F<n> --input <file.toml>  |  relay queue add --input <file.toml>")
            fields = relay_queue.read_add_input(o["--input"], relay_queue.FROM_KEYS if from_report else relay_queue.ADD_KEYS,
                                                ("why", "time") if from_report else ("title", "why", "time"))
            for flag, key in (("--time", "minutes"), ("--ip", "ip"), ("--kind", "kind")):
                if flag in o:
                    if key in fields:
                        raise Usage(f"{flag} is given in the input file and on the command line; give it once")
                    fields[key] = o[flag]
            if from_report:
                print(relay_queue.add_from(repo(o), o["--from"], p[0], **fields))
            else:
                print(relay_queue.add(repo(o), fields.pop("kind", "feature"), fields.pop("title"), **fields))
        except relay_queue.Refused as e:
            raise Usage(str(e))
        return 0
    if sub == "start":
        despite = "--despite-wait" in rest
        o, p = _queue_options([a for a in rest if a != "--despite-wait"], dict(common, **{"--scratch": str}))
        if len(p) != 1 or "--scratch" not in o:
            raise Usage("relay queue start <slug> --scratch <absolute folder> [--despite-wait] [-C <repo>]")
        try:
            print(relay_lanes.start(repo(o), p[0], o["--scratch"], despite_wait=despite))
        except relay_queue.Refused as e:
            raise Usage(str(e))
        return 0
    spec = {"land": ({}, 1), "ip": ({}, 2), "release": ({}, 1), "drop": ({"--input": str}, 1),
            "take": ({}, 1), "note": ({"--input": str}, 1), "edit": ({"--input": str}, 1), "done": ({"--test": str, "--evidence": str, "--fixed-by": str}, 1)}
    extra, count = spec[sub]
    o, p = _queue_options(rest, dict(common, **extra))
    if len(p) != count:
        raise Usage(QUEUE_USAGE)
    if sub == "land":
        print(relay_queue.land(repo(o), p[0]))
    elif sub == "ip":
        try:
            n = int(p[1])
        except ValueError:
            raise Usage("relay queue ip <slug> <n>: n is a whole number")
        print(relay_queue.set_ip(repo(o), p[0], n))
    elif sub == "release":
        print(relay_queue.release(repo(o), p[0]))
    elif sub == "drop":
        if "--input" not in o:
            raise Usage("relay queue drop <slug> --input <file.toml>: the TOML holds `why`, the owner's words")
        try:
            print(relay_queue.drop(repo(o), p[0], relay_queue.read_add_input(o["--input"], ("why",), ("why",), "dropped")["why"]))
        except relay_queue.Refused as e:
            raise Usage(str(e))
    elif sub == "take":
        print(relay_queue.take(repo(o), p[0]))
    elif sub == "edit":
        if "--input" not in o:
            raise Usage("relay queue edit <slug> --input <file.toml>: the TOML holds field, old, new and because; see relay queue --help")
        try:
            print(relay_queue.edit(repo(o), p[0], **relay_queue.read_edit_input(o["--input"])))
        except relay_queue.Refused as e:
            raise Usage(str(e))
    elif sub == "note":
        if "--input" not in o:
            raise Usage("relay queue note <slug> --input <file.toml>: the TOML holds one of said, fact, question (with options and number) or answer; see relay queue --help")
        try:
            print(relay_queue.note(repo(o), p[0], relay_queue.read_note_input(o["--input"])))
        except relay_queue.Refused as e:
            raise Usage(str(e))
    else:
        if "--fixed-by" in o:
            if "--test" not in o or "--evidence" in o:
                raise Usage("relay queue done <slug> --fixed-by <commit> --test <file>.py::<Class>::<name>: the commit that fixed it and its test")
            try:
                print(relay_queue.close_fixed_by(repo(o), p[0], o["--fixed-by"], o["--test"]))
            except relay_queue.Refused as e:
                raise Usage(str(e))
            return 0
        if "--evidence" in o:
            if "--test" in o:
                raise Usage("--test and --evidence do not go together: a fix has a test, a feature a commit or report")
            try:
                print(relay_queue.close_with_evidence(repo(o), p[0], o["--evidence"]))
            except relay_queue.Refused as e:
                raise Usage(str(e))
            return 0
        if "--test" not in o:
            raise Usage("relay queue done <slug> -C <worktree> --test <file>::<name>   |   relay queue done <slug> --evidence <sha>   |   relay queue done <slug> --fixed-by <commit> --test <file>.py::<Class>::<name>")
        print(relay_queue.done(repo(o), p[0], o["--test"]))
    return 0


def cmd_license(args):
    usage = "relay license add <SPDX id> [--holder <name>] [--year YYYY] [--headers code|config|docs] [-C <dir>]   |   relay license check [-C <dir>]"
    args = list(args)
    root = os.path.realpath(flag(args, "-C", "."))
    if not args or args[0] not in ("add", "check"):
        raise Usage(usage)
    sub = args.pop(0)
    try:
        if sub == "check":
            if args:
                raise Usage(usage)
            problems = relay_license.check(root)
            for line in problems:
                print(line)
            return 1 if problems else 0
        headers = []
        while "--headers" in args:
            headers.append(flag(args, "--headers"))
        holder, year = flag(args, "--holder"), flag(args, "--year")
        if len(args) != 1 or (year is not None and not re.fullmatch(r"\d{4}", year)):
            raise Usage(usage)
        for line in relay_license.add(root, args[0], holder, int(year) if year else None, headers):
            print(line)
    except relay_license.Refused as exc:
        print(f"relay license: {exc}", file=sys.stderr)
        return 1
    return 0


COMMANDS = {
    "status": cmd_status, "report": cmd_report, "improve": cmd_improve, "bench": cmd_bench, "profile": cmd_profile,
    "sync": cmd_sync, "candidate": cmd_candidate, "setup": lambda a: cmd_setup(a, migrate=False), "migrate": lambda a: cmd_setup(a, migrate=True),
    "calibrate": cmd_calibrate, "doctor": cmd_doctor, "install": cmd_install, "flows": cmd_flows, "rules": cmd_rules, "changed": cmd_changed, "check": cmd_check, "gate": cmd_gate, "land": cmd_land, "metrics": cmd_metrics, "precheck": cmd_precheck, "queue": cmd_queue, "license": cmd_license,
}


def help_text(cmd: str) -> str:
    """The usage lines of one command: its blocks of the module docstring (a line `  relay <cmd>` and its continuation lines)."""
    if cmd == "queue":
        return QUEUE_USAGE
    out: list[str] = []
    keep = False
    for line in __doc__.strip().splitlines():
        if line.startswith("  relay "):
            keep = line.split()[1] == cmd
        if keep:
            out.append(line)
    return "\n".join(out) if out else __doc__.strip()


def wants_help(args: list[str]) -> bool:
    """-h or --help anywhere before a bare `--` (what follows `--` belongs to another program)."""
    for a in args:
        if a == "--":
            return False
        if a in ("-h", "--help"):
            return True
    return False


def main(argv):
    if len(argv) < 2:
        print(__doc__.strip())
        return 2
    if argv[1] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    cmd, args = argv[1], list(argv[2:])
    if cmd not in COMMANDS:
        print(f"relay: unknown command '{cmd}'\n", file=sys.stderr)
        print(__doc__.strip(), file=sys.stderr)
        return 2
    if wants_help(args):
        print(help_text(cmd))
        return 0
    try:
        return COMMANDS[cmd](args) or 0
    except Usage as exc:
        print(f"relay {cmd}: {exc}", file=sys.stderr)
        return 2
    except (relay_rules.Fail, FileNotFoundError, ValueError) as exc:
        print(f"relay {cmd}: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
