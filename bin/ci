#!/usr/bin/env bash
# The single gate of the relay repository: a thin wrapper, the gate is lib/relay_ci.py (see its header).
#   bin/ci              every step, the paid ones included (plugin evals need `claude`)
#   bin/ci --quick      the free steps only; ends "QUICK MODE" and never releases
exec python3 "$(cd "$(dirname "$0")/.." && pwd -P)/lib/relay_ci.py" "$@"
