#!/usr/bin/env python3
"""The record step of bin/ci: files the plugin evals' result and prints what a person must see.

  bin/eval-record [--json .ci/evals.json] [--repo NAME] [--branch NAME] [--head SHA] [--keep 30]
  bin/eval-record --verdict RECORD        the verdict of a stored record under today's rule; stores nothing

Reads the eval's --json file. Exit 1 when the copy fails; exit 2 (with a "NOT A PASS" line naming the cases) when
a case fails its majority (most of the runs of an arm must pass: 2 of 3; the failed runs of a passing case are notes) with a failed meaning or code grader, a run the eval tool stopped at its time limit is a failed run of the majority, not an unjudged one; any other run was not judged (a run missing from runsPerCase, a partial batch) or there is no record, so the gate is not green; notes alone never change it.
  - no file: prints "NOT A PASS: plugin evals wrote no record" and exits 2 (bin/ci deletes the old file before the
    eval, so a leftover from yesterday is never filed as today's batch)
  - copies the file to $RELAY_HOME/evals/<repo>/<startedAt>-<branch>.json (RELAY_HOME defaults to ~/.relay)
    and keeps the newest --keep (30) files there
  - prints a summary line and, for each llm (meaning) grader: FAIL lines with the votes and the judged
    text, a note for every split vote (passing or failing), "not judged" for a grader without votes,
    the partial reason once, and a note when a session in the run read the project's rule file itself
No reason text exists: the judge answers one word (owner decision 1a); the record keeps the votes, the
judged text (`evidence`) and the rubric (`graderMarkdown`).
"""
import argparse, json, os, re, shutil, subprocess, sys
from fractions import Fraction
from typing import Any

# A case passes a batch when most of its runs pass (2 of 3): owner, 25 Oct, "Сценарий проходит с большинством".
# A fault that hits 1 run in 3 stays visible: the failed run's lines stay as notes and a falling rate is named.
HISTORY = 5   # how many of the newest earlier records a case's pass rate is compared with (a recent window, not all time)

RULE_FLAGS = ("rule-file-read-by-read", "rule-file-read-by-grep", "rule-file-read-by-bash")


def votes_text(votes):
    return " ".join("PASS" if v else "FAIL" for v in votes)


def line_checks():
    """{meaning grader: the code check whose line shows what it judged}, from questions.json (same pairing
    as the measurement). Empty when the file is not there."""
    try:
        qs = json.load(open(os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "evals", "judge-measure", "questions.json"), encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    return {q["grader"]: q["line"] for q in qs.values() if q.get("grader") and q.get("line")}


def judged_line(evidence, patterns):
    """The first evidence line that one of the given code checks matches, else the first 200 characters."""
    text = evidence or ""
    for pat, flags in patterns:
        try:
            rx = re.compile(pat, re.I if "i" in flags else 0)
        except re.error:
            continue
        for line in text.split("\n"):
            if line.strip() and rx.search(line):
                return line.strip()[:200]
    return " ".join(text.split())[:200]


def timed_out(run: dict[str, Any]) -> bool:
    """True when the eval tool stopped the run at its time limit ("timed out after 600s"). Owner, 27 Oct, "7. a": that is a failed run."""
    return str(run.get("error") or "").lower().startswith("timed out after")


def run_ok(run: dict[str, Any]) -> bool:
    """True when the run did not error and none of its graders failed."""
    return not run.get("error") and all(g.get("passed") is not False for g in run.get("graders", []))


def case_rates(data: dict[str, Any]) -> dict[str, tuple[int, int]]:
    """{case name: (runs that passed, runs)} over all arms of the case."""
    rates: dict[str, tuple[int, int]] = {}
    for case in data.get("cases", []):
        runs = [r for arm in (case.get("arms") or {}).values() for r in arm]
        rates[case["name"]] = (sum(run_ok(r) for r in runs), len(runs))
    return rates


def dropped(data: dict[str, Any], earlier: list[dict[str, Any]]) -> list[str]:
    """Names of the cases whose pass rate in `data` is below their pooled rate over the `earlier` records."""
    now = case_rates(data)
    before: dict[str, tuple[int, int]] = {}
    for old in earlier:
        if old.get("partial"):   # a broken (partial) batch is not a measured rate
            continue
        for name, (p, t) in case_rates(old).items():
            bp, bt = before.get(name, (0, 0))
            before[name] = (bp + p, bt + t)
    return sorted(n for n, (p, t) in now.items() if t and before.get(n, (0, 0))[1] and Fraction(p, t) < Fraction(*before[n]))


def report(data, record_path, earlier=()):
    """Returns the lines to print. A case passes when most of the runs of each arm pass; the failed runs of a passing case are notes."""
    notes, fails, splits, unjudged, bad, code_failed, timeouts = [], [], 0, 0, set(), 0, 0
    pairing = line_checks()
    if data.get("partial"):
        notes.append(f"    note: partial run: {data.get('partialReason', 'no reason given')}")
    for case in data.get("cases", []):
        llm = {g["name"] for g in case.get("graders", []) if g.get("type") == "llm"}
        regex = {g["name"]: (g.get("config", {}).get("pattern", ""), g.get("config", {}).get("flags", ""))
                 for g in case.get("graders", []) if g.get("type") == "regex" and g.get("config", {}).get("pattern")}

        def patterns_for(grader):
            """The grader's own code check; only when none is named, every code check of the case in order."""
            own = regex.get(pairing.get(grader))
            return [own] if own else list(regex.values())
        flagged = {}
        want = case.get("runsPerCase")
        for arm, runs in (case.get("arms") or {"": []}).items():
            missing = want - len(runs) if isinstance(want, int) and not isinstance(want, bool) else 0
            if missing > 0:
                unjudged += missing; bad.add(case["name"])
                notes.append(f"    note: {case['name']}: {missing} of {want} runs missing, not judged")
            arm_fails, arm_code, arm_bad = [], 0, set()   # the failures of this arm, kept until the arm's majority is known
            failed_runs, arm_timeouts = set(), 0
            for n, run in enumerate(runs, 1):
                if not run_ok(run):
                    failed_runs.add(n)
                if timed_out(run):   # a failed run of the majority rule, not a run that was not judged
                    arm_timeouts += 1; arm_bad.add(case["name"])
                    arm_fails.append(f"    FAIL {case['name']} run {n}: {run['error']}")
                    continue
                if run.get("error"):
                    unjudged += 1; bad.add(case["name"])
                    notes.append(f"    note: {case['name']} run {n}: the run errored ({str(run['error'])[:80]}), its graders were not judged")
                    if run.get("keptTracePath"):
                        notes.append(f"         trace: {run['keptTracePath']}")
                    continue
                present = {g.get("name") for g in run.get("graders", [])}
                for name in sorted(llm - present):
                    unjudged += 1; bad.add(case["name"])
                    notes.append(f"    note: {case['name']} run {n} {name}: not judged (no result for it in the run)")
                for g in run.get("graders", []):
                    name = g["name"]
                    if name in RULE_FLAGS:
                        m = re.search(r"called (\d+)x", g.get("explanation", ""))
                        if m and int(m.group(1)) > 0 and g.get("passed") is not False:   # a failed one is already a FAIL line
                            flagged.setdefault(n, []).append(name.rsplit("-", 1)[1].capitalize())
                    if name not in llm:
                        if g.get("passed") is False:   # a failed code (regex) grader fails the run
                            arm_code += 1; arm_bad.add(case["name"])
                            arm_fails.append(f"    FAIL {case['name']} run {n} {name}: code grader failed")
                        if run.get("keptTracePath"):
                            arm_fails.append(f"         trace: {run['keptTracePath']}")
                        continue
                    votes = g.get("judgeVotes")
                    if not isinstance(votes, list) or len(votes) != 3:
                        unjudged += 1; bad.add(case["name"])
                        notes.append(f"    note: {case['name']} run {n} {name}: not judged (cost ceiling)")
                        continue
                    split = len(set(votes)) > 1
                    splits += split
                    if not g.get("passed"):
                        arm_bad.add(case["name"])
                        arm_fails.append(f"    FAIL {case['name']} run {n} {name}: votes {votes_text(votes)}")
                        arm_fails.append(f"         judged: \"{judged_line(g.get('evidence'), patterns_for(name))}\"")
                        arm_fails.append(f"         record: {record_path}")
                        if run.get("keptTracePath"):
                            arm_fails.append(f"         trace: {run['keptTracePath']}")
                    if split:
                        notes.append(f"    note: {case['name']} run {n} {name} {'passed' if g.get('passed') else 'failed'} on a split vote ({votes_text(votes)})")
            if arm_fails and (len(runs) - len(failed_runs)) * 2 > len(runs):
                # most runs passed: the case passes, the failed runs stay visible as notes
                for line in arm_fails:
                    if line.startswith("    FAIL"):
                        notes.append("    note: " + line[len("    FAIL "):] + " (the case still passes by majority)")
                timed = f", {arm_timeouts} timed out" if arm_timeouts else ""
                notes.append(f"    note: {case['name']}{' ' + arm if arm else ''}: {len(runs) - len(failed_runs)} of {len(runs)} runs passed{timed}, the case passes by majority")
            else:
                fails += arm_fails; code_failed += arm_code; timeouts += arm_timeouts; bad |= arm_bad
        if flagged:
            runs_total = max((len(r) for r in case.get("arms", {}).values()), default=0)
            where = ", ".join(f"run {n}, {'/'.join(t)}" for n, t in sorted(flagged.items()))
            notes.append(f"    note: {case['name']}: a session in the run read the rule file in {len(flagged)} of {runs_total} runs ({where}), "
                         f"so those runs do not prove the hook delivered it")
    head = f"ci: eval record: {sum(1 for l in fails if l.startswith('    FAIL')) - code_failed - timeouts} meaning grader(s) failed, {splits} split vote{'s' if splits != 1 else ''}"
    head += f", {timeouts} run(s) timed out" if timeouts else ""
    head += f", {unjudged} not judged" if unjudged else ""
    for name in dropped(data, list(earlier)):
        p, t = case_rates(data)[name]
        notes.append(f"    note: {name}: pass rate fell to {p} of {t} runs, below its rate in the last {HISTORY} records")
    cost = data.get("costUsd")
    head += f", cost ${cost:.2f}" if isinstance(cost, (int, float)) and not isinstance(cost, bool) else ""
    out = [head] + fails + notes
    failed = sum(1 for l in fails if l.startswith("    FAIL"))
    if failed or unjudged or data.get("partial"):
        cases = sorted(bad)
        out.append(f"ci: eval record: NOT A PASS: {failed - code_failed - timeouts} meaning grader(s) failed, {str(code_failed) + ' code grader(s) failed, ' if code_failed else ''}{str(timeouts) + ' run(s) timed out, ' if timeouts else ''}{unjudged} not judged, in {', '.join(cases) or 'a partial run'}")
    return out


def is_green(data):
    """True when the batch is a pass: the same verdict `main` exits on (no case failed its majority of runs, meaning or code grader; nothing not judged; not partial)."""
    return "NOT A PASS" not in report(data, "")[-1]


def record_stem(data, branch):
    stamp = re.sub(r"[^0-9A-Za-z-]", "-", re.sub(r"\.\d+Z$", "Z", data.get("startedAt", "unknown")))
    return f"{stamp}-{re.sub(r'[^0-9A-Za-z._-]', '-', branch)}"


def store(src, data, home, repo, branch, keep, head=None, changed=False):
    folder = os.path.join(home, "evals", repo)
    os.makedirs(folder, exist_ok=True)
    dest = os.path.join(folder, record_stem(data, branch) + ".json")
    if head or changed:   # the record names the commit the run was made on; `bin/paid-cost due` reads it
        with open(dest, "w", encoding="utf-8") as out:
            json.dump(dict(data, head=head, branch=branch) if head else data, out)
    else:
        shutil.copyfile(src, dest)
    for old in sorted(os.listdir(folder))[:-keep] if keep > 0 else []:
        os.remove(os.path.join(folder, old))
    prune_traces(home, repo, os.listdir(folder))
    return dest


def failing_run(run):
    """A run whose cause a person may need to read: it errored, produced no graders, or a grader failed."""
    return bool(run.get("error")) or not run.get("graders") or any(g.get("passed") is False for g in run.get("graders", []))


def temp_folder(trace_path):
    """The eval tool's scaffold folder of a run (<tmp>/e-XXXX/out/trace.jsonl -> <tmp>/e-XXXX), else None: only what
    the tool itself made is ever removed."""
    out = os.path.dirname(trace_path)
    top = os.path.dirname(out)
    if os.path.basename(trace_path) == "trace.jsonl" and os.path.basename(out) == "out" and os.path.basename(top).startswith("e-"):
        return top
    return None


def remove_tree(top):
    """rmtree for the tool's run folders, which are read-only (top r-x, sealed/ 000): each folder is made owner-writable first."""
    for root, dirs, _ in os.walk(top):
        for d in dirs:
            try:
                os.chmod(os.path.join(root, d), 0o700)
            except OSError:
                pass
    try:
        os.chmod(top, 0o700)
    except OSError:
        pass
    shutil.rmtree(top, ignore_errors=True)


def keep_traces(data, home, repo, stem):
    """bin/ci runs the eval tool with --keep-temp, so every run's folder is still there. A red batch copies the failing
    runs' output folders to $RELAY_HOME/eval-traces/<repo>/<stem>/ and names the copy in the run (keptTracePath); a green
    batch keeps nothing. Either way the tool's temp folders are removed afterwards. When the tool writes no JSON at all
    (a crash, a killed gate) this step never runs and that batch's kept folders stay in the tmp folder for the OS to clear. Returns the number of copies."""
    red = not is_green(data)
    kept = 0
    for case in data.get("cases", []):
        for arm, runs in (case.get("arms") or {}).items():
            for n, run in enumerate(runs, 1):
                path = run.get("tracePath")
                if not isinstance(path, str) or not temp_folder(path):
                    continue
                if red and failing_run(run) and os.path.isdir(os.path.dirname(path)):
                    name = re.sub(r"[^0-9A-Za-z._-]", "-", f"{case.get('name', 'case')}-{arm or 'run'}-run{n}")
                    dest = os.path.join(home, "eval-traces", repo, stem, name)
                    shutil.copytree(os.path.dirname(path), dest, dirs_exist_ok=True)
                    run["keptTracePath"] = os.path.join(dest, "trace.jsonl")
                    kept += 1
                remove_tree(temp_folder(path))
    return kept


def prune_traces(home, repo, records):
    """Trace folders live as long as the record they belong to."""
    root = os.path.join(home, "eval-traces", repo)
    wanted = {name[:-5] for name in records if name.endswith(".json")}
    for name in os.listdir(root) if os.path.isdir(root) else []:
        if name not in wanted:
            shutil.rmtree(os.path.join(root, name), ignore_errors=True)


def earlier_records(folder: str, before: str = "") -> list[dict[str, Any]]:
    """The newest HISTORY complete stored records (names sorting before `before`, when given) that can be read.
    An unreadable file is skipped: it is only history. A partial record is skipped too: it is not a measured batch."""
    try:
        names = sorted(n for n in os.listdir(folder) if n.endswith(".json") and (not before or n < before))
    except OSError:
        return []
    out: list[dict[str, Any]] = []
    for n in reversed(names):
        if len(out) >= HISTORY:
            break
        try:
            rec = json.load(open(os.path.join(folder, n), encoding="utf-8"))
        except (OSError, ValueError):
            continue
        if isinstance(rec, dict) and not rec.get("partial"):
            out.append(rec)
    return out[::-1]


def git_name(*args):
    try:
        return subprocess.run(["git", *args], capture_output=True, text=True, check=True).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        return ""


def main(argv=None):
    ap = argparse.ArgumentParser()
    ap.add_argument("--json", default=".ci/evals.json")
    ap.add_argument("--repo")
    ap.add_argument("--branch")
    ap.add_argument("--head", help="the full sha the run was made on; stored in the record")
    ap.add_argument("--keep", type=int, default=30)
    ap.add_argument("--verdict", metavar="RECORD", help="print the verdict of a stored record under today's rule; stores nothing, exits 0 (pass) or 2")
    a = ap.parse_args(argv)
    if a.verdict:
        try:
            folder, base = os.path.split(os.path.abspath(a.verdict))
            lines = report(json.load(open(a.verdict, encoding="utf-8")), a.verdict, earlier_records(folder, base))
        except (OSError, ValueError) as e:
            print(f"ci: could not read the eval record: {e}")
            return 1
        print("\n".join(lines))
        print("ci: eval record: PASS" if "NOT A PASS" not in lines[-1] else "ci: eval record: RED")
        return 2 if "NOT A PASS" in lines[-1] else 0
    if not os.path.exists(a.json):
        print("ci: eval record: NOT A PASS: plugin evals wrote no record")
        return 2
    try:
        data = json.load(open(a.json, encoding="utf-8"))
        repo = a.repo or os.path.basename(os.path.dirname(os.path.abspath(git_name("rev-parse", "--git-common-dir")))) or "repo"
        branch = a.branch or git_name("rev-parse", "--abbrev-ref", "HEAD") or "detached"
        home = os.path.expanduser(os.environ.get("RELAY_HOME") or "~/.relay")
        earlier = earlier_records(os.path.join(home, "evals", repo))
        kept = keep_traces(data, home, repo, record_stem(data, branch))
        dest = store(a.json, data, home, repo, branch, a.keep, a.head, changed=bool(kept))
    except (OSError, ValueError) as e:
        print(f"ci: could not store the eval record: {e}")
        return 1
    lines = report(data, dest.replace(os.path.expanduser("~"), "~", 1), earlier)
    if "NOT A PASS" in lines[-1]:   # the pointer comes first: the verdict stays the last line
        print(f"ci: eval record: stored at {dest}; bin/eval-record --verdict {dest} shows why")
        print("\n".join(lines))
        return 2
    print("\n".join(lines))
    return 0


if __name__ == "__main__":
    sys.exit(main())
