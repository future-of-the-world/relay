#!/usr/bin/env bash
# bin/wt: worktrees for this project (the relay contract: new <name> <base> | rm <name> | ls).
# A worktree lives at .worktrees/<name> on branch wt/<name>.
set -euo pipefail
root="$(git rev-parse --path-format=absolute --git-common-dir)/.."
root="$(cd "$root" && pwd -P)"
dir="$root/.worktrees"
case "${1:-}" in
  new)
    name="${2:?name}"; base="${3:-master}"
    case "$name" in
      queue-*) echo "bin/wt: the name prefix 'queue-' is reserved for queue-landing branches; pick another name (e.g. task-${name})" >&2; exit 2 ;;
    esac
    mkdir -p "$dir"
    git -C "$root" worktree add "$dir/$name" -b "wt/$name" "$base" >/dev/null
    # relay is standard-library Python: nothing to prepare.
    echo "$dir/$name"
    ;;
  rm)
    name="${2:?name}"
    git -C "$root" worktree remove --force "$dir/$name"
    git -C "$root" branch -D "wt/$name" >/dev/null 2>&1 || true
    ;;
  ls) git -C "$root" worktree list ;;
  *) echo "usage: bin/wt new <name> [base] | rm <name> | ls" >&2; exit 2 ;;
esac
